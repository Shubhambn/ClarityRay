{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://clarityray.dev/schemas/clarity-schema.json",
  "title": "ClarityRay Model Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "certified",
    "model",
    "input",
    "output",
    "safety",
    "bodypart",
    "modality",
    "thresholds"
  ],
  "allOf": [
    {
      "$comment": "Binary models (task absent or \"binary\") must declare both single-score thresholds. Other tasks carry per-label thresholds in output.labels and may omit them.",
      "if": {
        "properties": {
          "output": {
            "properties": {
              "task": { "enum": ["binary"] }
            }
          }
        }
      },
      "then": {
        "properties": {
          "thresholds": {
            "required": ["possible_finding", "low_confidence"]
          }
        }
      }
    }
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "certified": {
      "type": "boolean",
      "const": false
    },
    "bodypart": {
      "type": "string",
      "minLength": 1
    },
    "modality": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file"],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string"
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "normalize"],
      "properties": {
        "shape": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "layout": {
          "type": "string"
        },
        "normalize": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mean", "std"],
          "properties": {
            "mean": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "number"
              }
            },
            "std": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classes", "activation"],
      "properties": {
        "task": {
          "type": "string",
          "enum": ["binary", "multilabel", "multiclass", "regression", "segmentation", "detection"],
          "description": "Output contract. Absent means \"binary\"."
        },
        "shape": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "activation": {
          "type": "string",
          "enum": ["softmax", "sigmoid", "none"]
        },
        "labels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
              "suspicious": { "type": "boolean" }
            }
          }
        },
        "units": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "range": {
          "type": ["array", "null"],
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number" }
        },
        "bands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tier", "label"],
            "properties": {
              "min": { "type": "number" },
              "max": { "type": "number" },
              "tier": {
                "type": "string",
                "enum": ["possible_finding", "no_finding", "low_confidence"]
              },
              "label": { "type": "string", "minLength": 1 }
            }
          }
        },
        "mask": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
            "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "detection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["box_format", "max_detections"],
          "properties": {
            "box_format": { "type": "string", "enum": ["xyxy", "xywh", "cxcywh"] },
            "max_detections": { "type": "integer", "minimum": 1 },
            "score_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
            "coord_space": { "type": "string", "enum": ["pixel", "normalized"] }
          }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "disclaimer"],
      "properties": {
        "tier": {
          "type": "string",
          "enum": ["screening", "research", "investigational"]
        },
        "disclaimer": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validation_status"],
      "properties": {
        "possible_finding": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "low_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "validation_status": {
          "type": "string",
          "enum": ["unvalidated", "validated"]
        }
      }
    },
    "source_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "source"],
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "selected_findings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "explainability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "method", "isModelBased", "isGradCAM", "disclaimer"],
      "properties": {
        "enabled": { "type": "boolean" },
        "method": { "type": "string", "enum": ["occlusion_sensitivity"] },
        "isModelBased": { "type": "boolean" },
        "isGradCAM": { "type": "boolean" },
        "disclaimer": { "type": "string", "minLength": 1 },
        "grid_size": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
