# ClarityRay frontend environment.
# Used by model registry pages/API proxying only.
# Scan inference remains browser-local and must not upload patient images.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side-only URL for the FastAPI backend (used by Next.js API routes, never
# sent to the browser). Set this in production (e.g. Vercel env vars) so the
# /api/models/manifest route can proxy the live Supabase manifest from FastAPI.
# Falls back to NEXT_PUBLIC_API_URL when unset (fine for local dev).
API_URL=http://localhost:8000
